# Application
APP_NAME=Code Assistant Backend
APP_VERSION=1.0.0
DEBUG=true

# Server
HOST=localhost
PORT=8000
WORKERS=4
LOG_LEVEL=info

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/dbname
# DATABASE_URL=postgresql+asyncpg://username:password@localhost:5432/dbname
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_ECHO=false

# Security
# Generate API key: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=your_api_key_here

# Generate encryption key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your_encryption_key_here

# CORS (comma-separated origins or "*" for all)
ALLOWED_ORIGINS=vscode-extension://claude-code,http://localhost:3000

# Pagination
DEFAULT_PAGE_SIZE=50
MAX_PAGE_SIZE=100

# LDAP
LDAP_HOST="ldap.example.com"
LDAP_PORT=389
LDAP_USE_SSL=False
LDAP_BIND_DN="your_bind_dn"
LDAP_BIND_PASSWORD="your_bind_password"
LDAP_SEARCH_BASE="DC=example,DC=com"
LDAP_SEARCH_FILTER="(|(sAMAccountName={username})(uid={username}))"
LDAP_USER_RDN_ATTR="sAMAccountName"
LDAP_USER_DOMAIN="example.com"
LDAP_TIMEOUT=5
